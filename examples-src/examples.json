      "value": "4700"
     }
    }
   ],
   "wires": [
    [
     "ee1:GND",
     "bluepill:GND.3",
     "black"
    ],
    [
     "ee1:VCC",
     "bluepill:3V3.2",
     "red"
    ],
    [
     "ee1:SCL",
     "bluepill:PB10",
     "green"
    ],
    [
     "ee1:SDA",
     "bluepill:PB11",
     "blue"
    ],
    [
     "r1:1",
     "bluepill:PB10",
     "green"
    ],
    [
     "r1:2",
     "bluepill:3V3.2",
     "red"
    ],
    [
     "r2:1",
     "bluepill:PB11",
