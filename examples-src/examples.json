 {
  "id": "ds3231_lcd_clock",
  "title": "DS3231 clock shown on an I2C LCD (needs 5 V)",
  "file": "ds3231_lcd_clock.c",
  "circuit": {
   "parts": [
    {
     "id": "rtc1",
     "type": "ds3231",
     "x": 540,
     "y": 50,
     "attrs": {
      "temp": "25",
      "start": "",
      "eeprom": "yes",
      "eeaddr": "0x57"
     }
    },
    {
     "id": "lcd1",
     "type": "lcdi2c",
     "x": 250,
     "y": 340,
     "attrs": {
      "i2c-address": "0x27"
     }
    }
   ],
   "wires": [
    [
     "rtc1:GND",
     "bluepill:GND.3",
     "black"
    ],
    [
     "rtc1:VCC",
     "bluepill:5V",
     "red"
    ],
    [
     "rtc1:SCL",
     "bluepill:PB10",
     "green"
    ],
    [
     "rtc1:SDA",
     "bluepill:PB11",
     "blue"
    ],
    [
     "lcd1:GND",
     "bluepill:GND.3",
     "black"
    ],
    [
     "lcd1:VCC",
     "bluepill:5V",
     "red"
    ],
    [
     "lcd1:SCL",
     "bluepill:PB10",
     "green"
    ],
    [
     "lcd1:SDA",
     "bluepill:PB11",
     "blue"
    ]
   ]
  }
 },
 {
